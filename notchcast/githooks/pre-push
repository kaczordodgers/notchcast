#!/bin/bash
set -euo pipefail
PATH="/opt/homebrew/bin:$PATH"
root="$(git rev-parse --show-toplevel)"
# A stale upstream puts its own commits in the range, and those authors are not ours.
git fetch -q upstream main || true
while read -r _local_ref local_sha _remote_ref _remote_sha; do
    if [[ "$local_sha" =~ ^0+$ ]]; then
        continue
    fi
    if [ "$(git cat-file -t "$local_sha")" = tag ]; then
        "$root/notchcast/check-identity.sh" tag "$local_sha"
    fi
    base="$(git merge-base "$local_sha" refs/remotes/upstream/main)"
    python3 "$root/notchcast/check-commit-emails.py" "$base..$local_sha"
    "$root/notchcast/check-identity.sh" history "$base" "$local_sha"
    gitleaks git --log-opts="$base..$local_sha" --redact --no-banner --exit-code 1 .
done
