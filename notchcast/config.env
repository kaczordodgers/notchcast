# Shared by Notchcast scripts and GitHub Actions. No secrets here.
UPSTREAM_REPO=abue-ammar/tinycast
FORK_REPO=kaczordodgers/notchcast
MAINTAINER_NAME=Damian
MAINTAINER_EMAIL=336236323+kaczordodgers@users.noreply.github.com
TESTED_CONTEXT=notchcast/tested
# Releases older than this upstream tag are never mirrored.
BASELINE_TAG=v0.12.6-beta.130
# Our app: built under this name and bundle id (project.yml); the installer migrates data from OLD_BUNDLE_ID once.
APP_NAME=Notchcast
BUNDLE_ID=app.notchcast
OLD_BUNDLE_ID=com.tinycast.app.beta
OLD_APP="/Applications/Tinycast Beta.app"
OLD_CONFIG_DIR=tinycast-beta
SIGN_IDENTITY="Notchcast Self-Signed"
# SHA-1 of the Notchcast Self-Signed leaf certificate (public). Releases are published, and installed by the updater, only when signed by it.
SIGN_SHA1=95280FD4EC25303CCC1FE2AA2A5E8B0A1A757DCC
# Harnesses the GitHub-hosted VM cannot run; they still run on a Mac. Vision OCR fails in the VM
# (CRImageReaderError) and so does capturing rendered text. Each must pass locally before being listed.
CI_SKIP_TESTS="clipboard-text-test form-input-test distill-convert-test nc-ScreenText-ocr-test"
# enmerasoftware/ai-design-check (npm @enmera/ai-design-check), run by notchcast/design-check.sh; pinned, bump on purpose.
DESIGN_CHECK_VERSION=0.12.0
JSCPD_VERSION=4.0.5
