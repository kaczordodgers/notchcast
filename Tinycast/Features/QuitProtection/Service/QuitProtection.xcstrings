{
  "sourceLanguage": "en",
  "strings": {
    "Press ⌘Q again to quit %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke ⌘Q erneut, um %@ zu beenden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa ⌘Q de nuevo para salir de %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez à nouveau sur ⌘Q pour quitter %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度⌘Qを押して%@を終了"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Q를 다시 눌러 %@ 종료"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione ⌘Q novamente para encerrar %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите ⌘Q ещё раз, чтобы выйти из %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再次按下 ⌘Q 以退出 %@"
          }
        }
      }
    },
    "Press ⌘W again to close a window in %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke ⌘W erneut, um ein Fenster in %@ zu schließen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa ⌘W de nuevo para cerrar una ventana en %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez à nouveau sur ⌘W pour fermer une fenêtre dans %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度⌘Wを押して%@のウインドウを閉じる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘W를 다시 눌러 %@의 윈도우 닫기"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione ⌘W novamente para fechar uma janela em %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите ⌘W ещё раз, чтобы закрыть окно в %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再次按下 ⌘W 以关闭 %@ 中的窗口"
          }
        }
      }
    },
    "Hold ⌘Q to quit %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte ⌘Q gedrückt, um %@ zu beenden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado ⌘Q para salir de %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez ⌘Q pour quitter %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Qを長押しして%@を終了"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Q를 길게 눌러 %@ 종료"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha ⌘Q pressionado para encerrar %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте ⌘Q, чтобы выйти из %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌘Q 以退出 %@"
          }
        }
