  "strings": {
    "Remote Mac updated.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote-Mac aktualisiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac remoto actualizado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac distant mis à jour."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートMacを更新しました。"
          }
        },
        "ko": {
