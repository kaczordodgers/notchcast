    },
    "Stopped following the remote update.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfolgung des Remote-Updates beendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se dejó de seguir la actualización remota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivi de la mise à jour distante arrêté."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモート更新の追跡を停止しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원격 업데이트 추적을 중지했습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O acompanhamento da atualização remota foi interrompido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отслеживание удалённого обновления остановлено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已停止跟踪远程更新。"
          }
        }
      }
    },
    "Unable to reach the remote Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
