            "value": "远程 Mac 已更新。"
          }
        }
      }
    },
    "Remote Mac is up to date.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Remote-Mac ist auf dem neuesten Stand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Mac remoto está actualizado."
          }
        },
        "fr": {
          "stringUnit": {
