            "value": "Le Mac distant est à jour."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートMacは最新です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원격 Mac이 최신 상태입니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mac remoto está atualizado."
