    "Cannot paste image here. Choose a writable Finder folder and allow Automation access in System Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Bild kann hier nicht eingefügt werden. Wähle einen beschreibbaren Finder-Ordner und erlaube Automation in den Systemeinstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede pegar la imagen aquí. Elige una carpeta de Finder con permiso de escritura y permite Automatización en Ajustes del Sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de coller l’image ici. Choisissez un dossier Finder accessible en écriture et autorisez Automatisation dans Réglages Système."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここに画像を貼り付けられません。書き込み可能なFinderフォルダを選び、システム設定でオートメーションを許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기에 이미지를 붙여넣을 수 없습니다. 쓰기 가능한 Finder 폴더를 선택하고 시스템 설정에서 자동화를 허용하세요."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível colar a imagem aqui. Escolha uma pasta gravável no Finder e permita Automação nos Ajustes do Sistema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось вставить изображение. Выберите доступную для записи папку Finder и разрешите автоматизацию в Системных настройках."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法在此处粘贴图像。请选择可写入的访达文件夹，并在系统设置中允许自动化访问。"
          }
        }
      }
    },
